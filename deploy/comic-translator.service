[Unit]
Description=comic-translator API + web (comic.tmpx.space): detect in the browser, LLM OpenRouter Gemini
Documentation=https://github.com/symunona/comic-translator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/comic-translator
Environment=TMPDIR=%h/comic-translator/tmp
EnvironmentFile=%h/comic-translator/.env
Environment=LLM=openrouter:google/gemini-3.8-flash
Environment=LLM_OCR=openrouter:google/gemini-3.8-flash?effort=low
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/comic-translator/bin/server \
  -addr 127.0.0.1:4720 \
  -data %h/comic-translator/data \
  -static %h/comic-translator/web \
  -models %h/comic-translator/vendor/models \
  -detector "" \
  -debug \
  -llm-concurrency 2
Restart=always
RestartSec=5
MemoryHigh=600M
MemoryMax=900M
# deploy.sh swaps bin/server by rename(2), so a restart never sees a half-copied binary.

[Install]
WantedBy=default.target

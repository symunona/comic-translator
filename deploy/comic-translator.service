[Unit]
Description=comic-translator API + web (comic.tmpx.space)
Documentation=https://github.com/symunona/comic-translator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/comic-translator
Environment=TMPDIR=%h/comic-translator/tmp
Environment=ORT_LIB=%h/comic-translator/vendor/onnxruntime/lib/libonnxruntime.so
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/comic-translator/bin/server \
  -addr 127.0.0.1:4720 \
  -data %h/comic-translator/data \
  -static %h/comic-translator/web \
  -detector %h/comic-translator/vendor/detector.onnx \
  -llm-concurrency 2 \
  -ort-threads 2
Restart=always
RestartSec=5
MemoryHigh=1400M
MemoryMax=1800M
# deploy.sh swaps bin/server by rename(2), so a restart never sees a half-copied binary.

[Install]
WantedBy=default.target

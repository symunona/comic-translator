[Unit]
Description=comic-translator browser-offload env: detect runs in the browser (comic-browser.tmpx.space)
Documentation=https://github.com/symunona/comic-translator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/comic-browser
Environment=TMPDIR=%h/comic-browser/tmp
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/comic-browser/bin/server \
  -addr 127.0.0.1:4740 \
  -data %h/comic-browser/data \
  -static %h/comic-browser/web \
  -models %h/comic-browser/vendor/models \
  -detector "" \
  -debug \
  -llm-concurrency 2
Restart=always
RestartSec=5
MemoryHigh=600M
MemoryMax=900M

[Install]
WantedBy=default.target
